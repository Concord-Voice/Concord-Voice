{
  "name": "@concordvoice/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern src e2e *.ts *.json *.html",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src e2e *.ts *.json *.html",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.14.10",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "prettier": "^3.9.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": "^7.5.16",
    "@tootallnate/once": "^1.0.3",
    "tmp": "^0.2.7",
    "serialize-javascript": "^7.0.3",
    "minimatch": "^9.0.7",
    "rollup": "^4.59.0",
    "fast-uri": "^3.1.2",
    "ws": "^8.21.0",
    "undici": "^7.28.0",
    "@babel/core": "^7.29.6"
  }
}
