# Match go.mod's toolchain (falling back to its go directive); checked by
# scripts/check-go-toolchain.py alongside the control-plane Dockerfile.
FROM golang:1.26.9-alpine@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0 AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ops-agent ./cmd/ops-agent

FROM scratch

LABEL org.opencontainers.image.source="https://github.com/Concord-Voice/Concord-Voice"
LABEL org.opencontainers.image.description="Concord Voice isolated operations metrics agent"
LABEL org.opencontainers.image.licenses="LicenseRef-CVSL-1.0"

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/ops-agent /ops-agent

# Root is required for the isolated host Docker socket; Compose drops all capabilities.
USER 0:0

ENTRYPOINT ["/ops-agent"]
