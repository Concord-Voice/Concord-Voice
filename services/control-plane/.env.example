# Concord Voice Control Plane - Environment Variables Template
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgres://concord:your_password_here@localhost:5432/concord?sslmode=disable

# Redis Configuration (password must match REDIS_PASSWORD in the repo-root .env)
# The DB component of this URL is advisory for TESTS: since #2680 each `go test`
# process allocates its own Redis logical database. Host and credentials are
# honoured; the index is not. Application runs are unaffected.
REDIS_URL=redis://:concord_dev_redis@localhost:6379

# TEST-ONLY escape hatch (#2680). Pins one Redis logical DB index and skips
# per-process allocation — for inspecting a specific database while debugging.
# Leave it unset: isolation is on by default and this only takes it away.
#
# It DISABLES isolation rather than redirecting it. Two processes that inherit
# the same pin share one database, their indices match by construction, and the
# redistest.Reset guard therefore permits each to flush the other — the guard
# compares addresses and indices, it does not register ownership. Export it for
# one foreground command, never in a shell you then run a second `go test` from.
#
# Read solely by internal/testhelpers/redistest; never by pkg/config. 0 and any
# non-positive value are rejected (0 holds the allocator counter and dev data).
# CONCORD_TEST_REDIS_DB=5

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_secret_key_here

# Server Configuration
PORT=8080
ENVIRONMENT=development

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Optional: Rate Limiting
RATE_LIMIT_ENABLED=true

# Trusted reverse-proxy CIDRs (comma-separated IPv4/IPv6 CIDRs).
# REQUIRED in production — an unset value fails startup via config validate().
# In non-production (development/staging/CI), an unset value falls back to
# 172.16.0.0/12 (broad RFC1918 Docker range). The docker-compose bridge
# network typically uses 172.19.0.0/16, which is the tighter value pinned
# here and in the compose file. Malformed CIDRs fail startup in all envs.
# Without a correct value, c.ClientIP() returns the nginx container address
# and breaks IP-based rate limiting, authban, session audit, and observability.
TRUSTED_PROXY_CIDRS=172.19.0.0/16

# Optional: NATS Configuration (for future use)
# NATS_URL=nats://localhost:4222

# Activity History (#1235). The cluster gate controls capability advertisement
# and new consent only. Keep false until the serving set is fully drained and
# `concord-ctl.sh activity-history-activate --confirm-drained` succeeds.
ACTIVITY_HISTORY_CLUSTER_ENABLED=false
CONTROL_PLANE_REPLICA_COUNT=1
# Required for self-hosted consent availability; SaaS builds supply canonical
# disclosure in the binary. Privacy URL must be absolute HTTPS when non-empty.
ACTIVITY_HISTORY_OPERATOR_NAME=
ACTIVITY_HISTORY_PRIVACY_POLICY_URL=

# Optional public client version floor. Empty disables enforcement.
# Example only; production remains unset until the client release is live:
# CLIENT_MIN_VERSION=0.2.44
CLIENT_MIN_VERSION=
