# Server configuration
PORT=3000
ENVIRONMENT=development
JWT_SECRET=

# Inter-service communication
NATS_URL=nats://localhost:4222
# Password must match REDIS_PASSWORD in the repo-root .env (compose uses --requirepass)
REDIS_URL=redis://:concord_dev_redis@localhost:6379

# --- WebRTC / mediasoup ---------------------------------------------------
# ANNOUNCED_IP is the address mediasoup puts in its ICE candidates. The RTC
# sockets always bind 0.0.0.0, so this is purely what the SFU *advertises*.
#
# Leave it empty ONLY where every client reaches this media plane at 127.0.0.1
# -- clients on this same host, or a loopback-only container. One non-loopback
# interface does not make loopback reachable to a remote peer. Otherwise the
# default 127.0.0.1 is silently wrong: the kernel answers the browser's STUN checks
# from the routable interface, the browser discards the reply as non-symmetric
# (RFC 8445 s7.2.5.2.1), never nominates the pair, and DTLS never starts. Media
# then fails completely with no error logged anywhere. Set it to this host's
# LAN address, e.g.:
#   ANNOUNCED_IP=192.168.1.20
#
# Left empty, the service warns at startup and lists the routable IPv4
# addresses it can see, without choosing one -- a VPN, VM or container-bridge
# address passes the same test as the LAN address a client actually uses. No
# warning does not mean the value is right: a host with no routable IPv4
# address (IPv6-only, or link-local only) has nothing to list.
ANNOUNCED_IP=

# RTC port range for WebRTC media. The code default is 40000-49999, and that
# WIDTH IS DELIBERATE -- it is the envelope `ufw allow 40000:49999/udp` and the
# DOCKER-USER RETURN open, and the one ADR-0042 allocates blue-green colour
# ranges inside. Do not narrow the code default to "fix" an overlap.
#
# Every shipped compose file narrows this per deployment to match what it
# publishes -- 40000-40099 (dev), 40000-40199 (staging), 40000-41999 (production)
# -- because mediasoup will happily bind a port Docker never published, which
# fails with no useful diagnostic. test-rtc-port-ingress-parity.sh asserts that
# containment for every compose file.
#
# Running the media-plane DIRECTLY ON THE HOST (not under compose) is the case
# this file is for, and there the full 40000-49999 overlaps coturn's published
# 49152-49252/udp. That is not fatal -- coturn binds first and mediasoup retries
# another port -- but it wastes binds, so narrow it here to match dev compose.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40099

# mediasoup worker log level: error | warn | debug (default warn).
# The worker's own ICE/DTLS tracing ALSO needs DEBUG=mediasoup* in the process
# environment -- this variable alone only sets what the worker emits.
MEDIASOUP_LOG_LEVEL=warn
